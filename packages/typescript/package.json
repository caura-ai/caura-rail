{
  "name": "@caura/rail",
  "version": "1.0.2",
  "description": "Caura Rail (preview): deterministic recall and commit around every agent turn, for Caura (formerly MemClaw) governed shared memory.",
  "keywords": [
    "caura",
    "caura rail",
    "agent memory",
    "ai agent memory",
    "shared memory",
    "multi-agent",
    "agent db",
    "agent fleet memory",
    "mcp",
    "governed memory",
    "llm memory",
    "recall",
    "memclaw"
  ],
  "homepage": "https://github.com/caura-ai/caura-rail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caura-ai/caura-rail.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/caura-ai/caura-rail/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^5.9.3"
  }
}
