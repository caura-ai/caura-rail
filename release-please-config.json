{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "signoff": "release-please[bot] <release-please[bot]@users.noreply.github.com>",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "draft": false,
  "prerelease": false,
  "changelog-path": "CHANGELOG.md",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation", "hidden": false },
    { "type": "refactor", "section": "Code Refactoring", "hidden": false },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "caura-rail",
      "extra-files": [
        { "type": "toml", "path": "packages/python/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": "packages/typescript/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/typescript'].version" },
        { "type": "generic", "path": "packages/typescript/src/version.ts" }
      ]
    }
  }
}
